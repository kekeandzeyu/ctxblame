      "properties": {
       "path": {
        "type": "string"
       }
      },
      "required": [
       "path"
      ]
     }
    },
    {
     "name": "deploy",
     "description": "Deploy a service version to an environment.",
     "input_schema": {
      "type": "object",
      "properties": {
       "service": {
        "type": "string"
       },
       "version": {
        "type": "string"
       },
       "env": {
        "type": "string",
        "enum": [
         "staging",
         "production"
        ]
       }
      },
      "required": [
       "service",
       "version",
       "env"
      ]
     }
    },
    {
     "name": "check_calendar",
     "description": "List events in a team calendar for a date (YYYY-MM-DD).",
     "input_schema": {
      "type": "object",
      "properties": {
       "calendar": {
        "type": "string"
       },
       "date": {
        "type": "string"
       }
      },
      "required": [
       "calendar",
       "date"
      ]
     }
    }
   ],
   "messages": [
